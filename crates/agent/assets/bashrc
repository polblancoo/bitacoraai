# crewhelm-default v1
# Configuración por defecto de CrewHelm. Para personalizarla, borrá la primera línea (así CrewHelm ya no la reemplaza).
export LANG="${LANG:-C.UTF-8}" COLORTERM=truecolor PAGER=less LESS='-R'
export EDITOR="${EDITOR:-nano}"; command -v nvim >/dev/null && export EDITOR=nvim
export PATH="$HOME/.local/bin:$PATH"
HISTSIZE=50000; HISTFILESIZE=50000; HISTCONTROL=ignoredups:ignorespace; shopt -s histappend checkwinsize autocd 2>/dev/null
command -v dircolors >/dev/null && eval "$(dircolors -b)"
if command -v eza >/dev/null; then alias ls='eza --group-directories-first' ll='eza -lah --group-directories-first --git'; else alias ls='ls --color=auto' ll='ls -lah'; fi
alias grep='grep --color=auto' ..='cd ..' gs='git status -sb'
bind '"\e[A": history-search-backward' 2>/dev/null; bind '"\e[B": history-search-forward' 2>/dev/null
if command -v starship >/dev/null; then eval "$(starship init bash)"; else PS1='\[\e[36m\]\u@crewhelm\[\e[0m\] \[\e[33m\]\w\[\e[0m\] \$ '; fi
